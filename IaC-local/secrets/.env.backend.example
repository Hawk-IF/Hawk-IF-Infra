# Aplicação
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=sua_chave_secreta_geral_muito_segura_aqui

# JWT
JWT_SECRET_KEY=sua_chave_secreta_exclusiva_para_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco de Dados (Postgres). OBS: Demais envs estao no arquivo de env postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_SERVER=database
POSTGRES_PORT=5432

# Redis e Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2